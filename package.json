{
  "name": "estude-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run dev:saas",
    "dev:saas": "concurrently --kill-others --names NEXT,PROXY \"npm:dev:saas:next\" \"npm:dev:saas:proxy\"",
    "dev:saas:next": "cross-env NEXT_PUBLIC_API_URL=/api/v1 NEXT_PUBLIC_AUTH_PORTAL= ESTUDE_APP_ROLE= NEXT_DIST_DIR=.next-go-local next dev --hostname 0.0.0.0 --port 3000",
    "dev:saas:proxy": "node scripts/dev-saas-proxy.mjs",
    "dev:home": "cross-env NEXT_PUBLIC_AUTH_PORTAL=home NEXT_DIST_DIR=.next-home next dev -p 3004",
    "dev:admin": "cross-env NEXT_PUBLIC_AUTH_PORTAL=admin NEXT_DIST_DIR=.next-admin next dev",
    "dev:teacher": "cross-env NEXT_PUBLIC_AUTH_PORTAL=teacher NEXT_DIST_DIR=.next-teacher next dev",
    "dev:student": "cross-env NEXT_PUBLIC_AUTH_PORTAL=student NEXT_DIST_DIR=.next-student next dev",
    "dev:parent": "cross-env NEXT_PUBLIC_AUTH_PORTAL=parent NEXT_DIST_DIR=.next-parent next dev",
    "serve": "npm run serve:all",
    "serve:all": "concurrently --kill-others --names APP,ROLES --prefix-colors blue,magenta \"npm:serve:admin\" \"npm:serve:roles\"",
    "serve:admin": "cross-env ESTUDE_APP_ROLE=ADMIN NEXT_DIST_DIR=.next-admin next dev -p 3000",
    "serve:teacher": "cross-env ESTUDE_APP_ROLE=TEACHER NEXT_DIST_DIR=.next-teacher next dev -p 3001",
    "serve:student": "cross-env ESTUDE_APP_ROLE=STUDENT NEXT_DIST_DIR=.next-student next dev -p 3002",
    "serve:parent": "cross-env ESTUDE_APP_ROLE=PARENT NEXT_DIST_DIR=.next-parent next dev -p 3003",
    "serve:roles": "node scripts/serve-role-proxies.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:chat": "node tests/class-chat.test.cjs",
    "test:proxy": "node --test tests/go-api-proxy.test.cjs",
    "test:content": "node --test tests/content.test.cjs",
    "test:assignment": "node --test tests/assignment.test.cjs",
    "test:gradebook": "node --test tests/gradebook.test.cjs",
    "test:parent": "node --test tests/parent-child-navigation.test.cjs tests/parent-learning-alerts.test.cjs",
    "test:ai-questions": "node --test tests/ai-question-bulk-approve.test.cjs tests/unsaved-question-changes.test.cjs",
    "test:assessment-report": "node --test tests/exam-class-report.test.cjs tests/exam-results-overview.test.cjs tests/exam-submissions-panel.test.cjs tests/exam-analysis-page.test.cjs tests/subject-support.test.cjs tests/parent-learning-alerts.test.cjs",
    "test:study-evidence": "node --test tests/study-evidence.test.cjs tests/study-evidence-api.test.cjs tests/study-evidence-panels.test.cjs",
    "test:learning-interventions": "node --test tests/learning-interventions.test.cjs tests/learning-support-group.test.cjs tests/learning-support-inbox.test.cjs",
    "test:study-coach": "node --test tests/study-coach-flashcards.test.cjs tests/study-coach-quiz.test.cjs tests/study-coach-ui.test.cjs tests/study-coach-materials.test.cjs",
    "test:internal-results": "node --test tests/internal-results.test.cjs"
  },
  "dependencies": {
    "@vercel/functions": "3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.7.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "http-proxy": "^1.18.1",
    "postcss": "^8.4.49",
    "react-test-renderer": "19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
