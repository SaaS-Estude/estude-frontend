NEXT_PUBLIC_API_URL=/api/v1

# Server-only destination for the production Next.js API proxy.
# On Vercel: GO_API_URL=https://saas-api.estude.io.vn
GO_API_URL=http://127.0.0.1:8090

# Go API served through the same origin as the school portal.
# Tenant identity comes from the registered portal hostname.
# Local development: npm run dev:saas (Next 3000 + proxy 8091 -> Go 8090).
