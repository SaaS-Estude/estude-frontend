NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# After a module passes Go acceptance, deploy its API at same-origin /api/v1.
# Tenant identity comes from the registered portal hostname; no tenant header.
# Existing NEXT_PUBLIC_API_URL remains unchanged during G01.
# Set go only for the G02 staging portal; use a same-origin /api/v1 proxy.
# NEXT_PUBLIC_BACKEND=go
